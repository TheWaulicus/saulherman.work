---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import ThemeToggle from '../components/ThemeToggle.astro';
import Footer from '../components/Footer.astro';
import toolkit from '../data/toolkit.json';
import { toPlainDateString, toYearMonthString } from '../utils/dates';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Saul Herman - IT Manager & Platform Engineer at Neara. Building identity lifecycle automation and AI-agent-operated IT platforms; ex-Atlassian (17,000+ macOS fleet).",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = new URL('/', Astro.site).href;
const resumeURL = new URL('/saul_herman_resume.pdf', Astro.site).href;
const ogImageURL = new URL('/og-image.png', Astro.site).href;

function toPlainText(markdown: string): string {
  return markdown
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[*_`]/g, '')
    .trim();
}

function bulletsOf(body: string | undefined): string[] {
  return (body ?? '')
    .split('\n')
    .filter((line) => line.startsWith('- '))
    .map((line) => toPlainText(line.slice(2)));
}

const experienceEntries = await getCollection('experience');
experienceEntries.sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

const projectEntries = await getCollection('projects');
projectEntries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const experience = experienceEntries.map((entry) => ({
  role: entry.data.role,
  company: entry.data.company,
  location: entry.data.location,
  startDate: toYearMonthString(entry.data.startDate),
  endDate: entry.data.endDate ? toYearMonthString(entry.data.endDate) : null,
  current: !entry.data.endDate,
  tags: entry.data.tags ?? [],
  summary: bulletsOf(entry.body),
}));

const projects = projectEntries.map((entry) => ({
  slug: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  type: entry.data.type,
  featured: entry.data.featured,
  date: toPlainDateString(entry.data.date),
  tags: entry.data.tags ?? [],
  page: new URL(`/projects/${entry.id}/`, Astro.site).href,
  externalUrl: entry.data.url ?? null,
}));

const current = experience.find((role) => role.current) ?? experience[0];

const portfolioData = {
  candidate: {
    name: 'Saul Herman',
    currentRole: current?.role ?? 'IT Manager',
    company: current?.company ?? 'Neara',
    location: current?.location ?? 'Sydney, Australia',
    summary:
      'IT Manager at Neara, building identity lifecycle automation and AI-agent-operated IT platforms. Ex-Atlassian, where he managed 17,000+ macOS devices at scale.',
    highlights: [
      'Designed and built an identity lifecycle platform that automates onboarding, offboarding, access audit, and remediation across 15 SaaS services.',
      'Runs IT operations as an AI-agent development workflow with 14 reusable agent skills, MCP servers, and 1Password Environment secrets.',
      'At Atlassian, managed 17,000+ corporate macOS and 15,000+ BYOD devices and implemented 75%+ CIS Level 2 for corporate macOS.',
    ],
    website: siteURL,
    resumePdf: resumeURL,
  },
  contact: {
    email: 'saulmherman@icloud.com',
    github: 'https://github.com/thewaulicus',
    linkedin: 'https://linkedin.com/in/bettercallsaui',
    website: siteURL,
    resumePdf: resumeURL,
  },
  projects,
  experience,
  toolkit: toolkit.map((group) => ({ category: group.category, items: group.items })),
};

const safeJson = JSON.stringify(portfolioData)
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="text-scale" content="scale" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0a" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fcfcfc" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="expect" href="#main-content" blocking="render" />

    <script is:inline {...{ blocking: 'render' }}>
      try {
        const saved = localStorage.getItem('color-scheme') ?? localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.querySelector('meta[name="color-scheme"]').content = saved;
        }
      } catch {}

      window.addEventListener('pagereveal', (event) => {
        if (!event.viewTransition) return;
        const activation = window.navigation?.activation;
        if (!activation?.from?.url || !activation.entry?.url) return;
        const fromPath = new URL(activation.from.url).pathname;
        const toPath = new URL(activation.entry.url).pathname;
        if (fromPath === '/' && toPath.startsWith('/projects/')) {
          event.viewTransition.types.add('forward');
        } else if (fromPath.startsWith('/projects/') && toPath === '/') {
          event.viewTransition.types.add('backward');
        }
      });
    </script>

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-serif-display-latin-400.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Saul Herman" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Saul Herman - IT Manager & Platform Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <slot name="head" />

    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "tag": "portfolio-prefetch",
            "where": {
              "and": [
                { "href_matches": ["/projects/*", "/"] },
                { "not": { "href_matches": "/*.pdf" } },
                { "not": { "selector_matches": "[download]" } }
              ]
            },
            "eagerness": "eager"
          }
        ],
        "prerender": [
          {
            "tag": "portfolio-prerender",
            "where": {
              "and": [
                { "href_matches": ["/projects/*", "/"] },
                { "not": { "href_matches": "/*.pdf" } },
                { "not": { "selector_matches": "[download]" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link visually-hidden">Skip to main content</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Primary">
        <a href="/" class="site-brand">Saul Herman</a>
        <ul class="nav-links" role="list">
          <li><a href="/#projects">Projects</a></li>
          <li><a href="/#experience">Experience</a></li>
          <li><a href="/#toolkit">Toolkit</a></li>
        </ul>
      </nav>
      <ThemeToggle />
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script type="application/json" id="portfolio-data" is:inline set:html={safeJson} />
    <script>
      import '../scripts/webmcp';
    </script>
  </body>
</html>

<style>
  .skip-link:focus-visible {
    position: fixed;
    inset-block-start: 1rem;
    inset-inline-start: 1rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    border: 1px solid var(--accent);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-inline-size: 62.5rem;
    margin-inline: auto;
    padding: 1.25rem 2rem 0;
  }

  .site-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }

  .site-brand {
    display: inline-flex;
    align-items: center;
    min-block-size: 1.5rem;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--text);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-block-size: 1.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--sub);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-brand:hover,
  .nav-links a:hover {
    color: var(--accent);
  }

  main {
    max-inline-size: 62.5rem;
    margin-inline: auto;
    padding: 2rem;
  }

  main:focus {
    outline: none;
  }

  /* Footer renders outside <main>, so align it with the main content column. */
  body > :global(.footer) {
    inline-size: min(58.5rem, 100% - 4rem);
    margin-inline: auto;
  }

  @media (pointer: coarse) {
    .site-brand,
    .nav-links a {
      min-block-size: 2.75rem;
    }
  }

  @media (max-width: 37.5em) {
    .site-header {
      align-items: flex-start;
      padding-inline: 1.25rem;
    }

    .site-nav {
      flex-direction: column;
      align-items: flex-start;
    }

    .nav-links {
      gap: 0.25rem 1rem;
    }

    main {
      padding-inline: 1.25rem;
    }

    body > :global(.footer) {
      inline-size: calc(100% - 2.5rem);
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import BentoToolkit from '../components/BentoToolkit.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const featuredProjects = await getCollection('projects', ({ data }) => {
  return data.featured === true;
});

// Sort projects by date descending
featuredProjects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Saul Herman | Product Engineer">
  <Hero />
  
  {featuredProjects.length > 0 && (
    <section class="featured-projects">
      <h2>Featured Projects</h2>
      <div class="projects-grid">
        {featuredProjects.map(project => (
          <FeatureCard
            title={project.data.title}
            description={project.data.description}
            tags={project.data.tags}
            type="product"
            href={project.data.url}
          />
        ))}
      </div>
    </section>
  )}

  <ExperienceTimeline />

  <BentoToolkit />

  <Footer />
</BaseLayout>

<style>
  .featured-projects {
    margin: 4rem 0;
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: var(--accent);
    font-family: var(--font-serif);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

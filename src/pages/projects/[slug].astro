---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatMonthYear, toPlainDateString } from '../../utils/dates';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);

const siteURL = new URL('/', Astro.site).href;
const projectsURL = new URL('/#projects', Astro.site).href;
const pageURL = new URL(`/projects/${project.id}/`, Astro.site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Projects', item: projectsURL },
      { '@type': 'ListItem', position: 2, name: project.data.title, item: pageURL },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    '@id': `${pageURL}#work`,
    name: project.data.title,
    description: project.data.description,
    url: pageURL,
    dateCreated: toPlainDateString(project.data.date),
    keywords: project.data.tags?.join(', '),
    ...(project.data.url ? { sameAs: project.data.url } : {}),
    author: { '@type': 'Person', '@id': `${siteURL}#person`, name: 'Saul Herman', url: siteURL },
  },
];

const jsonLdString = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<BaseLayout title={`${project.data.title} - Saul Herman`} description={project.data.description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={jsonLdString} />
  </Fragment>

  <article class="project">
    <nav class="breadcrumb" aria-label="Breadcrumbs">
      <ol role="list">
        <li><a href="/#projects">Projects</a></li>
        <li><a href={`/projects/${project.id}/`} aria-current="page">{project.data.title}</a></li>
      </ol>
    </nav>

    <header class="project-header" data-vt-card={project.id}>
      <h1 data-vt-title={project.id}>{project.data.title}</h1>
      <p class="description">{project.data.description}</p>
      <div class="meta">
        <time datetime={toPlainDateString(project.data.date)}>{formatMonthYear(project.data.date, 'long')}</time>
        {project.data.tags && (
          <ul class="tags" role="list" aria-label="Technologies">
            {project.data.tags.map(tag => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        )}
      </div>
      {project.data.url && (
        <a href={project.data.url} class="btn" target="_blank" rel="noopener noreferrer">
          {project.data.urlLabel ?? 'Visit project'}
          <span aria-hidden="true">&nearr;</span>
        </a>
      )}
    </header>

    <div class="mdx-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project {
    padding-top: 2rem;
  }

  .breadcrumb {
    margin-bottom: 2.5rem;
    font-size: 0.9rem;
  }

  .breadcrumb > ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumb > ol > li {
    display: inline-flex;
    align-items: center;
  }

  .breadcrumb > ol > li + li::before {
    content: "/";
    content: "/" / "";
    margin-inline-end: 0.5rem;
    color: var(--muted);
  }

  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    min-block-size: 1.5rem;
    color: var(--sub);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, currentColor 40%, transparent);
    text-underline-offset: 0.2em;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .breadcrumb a[aria-current="page"] {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  @media (pointer: coarse) {
    .breadcrumb a {
      min-block-size: 2.75rem;
    }
  }

  @media (forced-colors: active) {
    .breadcrumb a[aria-current="page"] {
      text-decoration: underline;
    }
  }

  .project-header h1 {
    font-size: clamp(1.75rem, 1.2rem + 3vw, 3rem);
    line-height: 1.1;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .description {
    font-size: 1.15rem;
    color: var(--sub);
    max-inline-size: 65ch;
    margin-bottom: 1.5rem;
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
    font-size: 0.9rem;
    color: var(--sub);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    background: var(--tag-bg);
    border: 1px solid var(--tag-border);
    border-radius: 4px;
    color: var(--sub);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.25rem;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--accent);
    border-radius: 6px;
    color: var(--accent);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .btn:hover {
    background: var(--tag-bg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .btn:hover {
      transform: translateY(-2px);
    }
  }

  @media (pointer: coarse) {
    .btn {
      min-block-size: 2.75rem;
    }
  }

  .mdx-content {
    margin-top: 3rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text);
  }

  .mdx-content :global(h2) {
    font-size: 1.75rem;
    color: var(--accent);
    margin: 2.5rem 0 1rem;
  }

  .mdx-content :global(h3) {
    font-size: 1.4rem;
    color: var(--accent);
    margin: 2rem 0 1rem;
  }

  .mdx-content :global(ul) {
    padding-left: 1.25rem;
  }

  .mdx-content :global(li) {
    margin-bottom: 0.75rem;
  }

  .mdx-content :global(strong) {
    color: var(--text);
  }
</style>

---
import toolkit from '../data/toolkit.json';
---

<section class="toolkit">
  <h2>Toolkit</h2>
  <div class="bento-grid">
    {toolkit.map(group => (
      <div class={`bento-item ${group.size} glass`}>
        <h3>{group.category}</h3>
        <div class="skill-list" role="list">
          {group.items.map(item => (
            <span class="skill-tag" role="listitem">{item}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .toolkit {
    margin: 4rem 0;
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: var(--accent);
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(150px, auto);
    gap: 1.5rem;
  }

  .bento-item {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .bento-item h3 {
    font-size: 1.1rem;
    color: var(--sub);
    margin-bottom: 1.5rem;
    font-family: var(--font-sans);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skill-tag {
    font-size: 0.9rem;
    color: var(--text);
    padding: 0.4rem 0.8rem;
    background: var(--tag-bg);
    border: 1px solid var(--tag-border);
    border-radius: 6px;
    transition: all 0.2s ease;
    cursor: default;
  }

  .skill-tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Bento Layout Spans */
  .large {
    grid-column: span 2;
    grid-row: span 2;
  }

  .medium {
    grid-column: span 1;
    grid-row: span 2;
  }

  .small {
    grid-column: span 1;
    grid-row: span 1;
  }

  /* Re-layout for medium screens */
  @media (max-width: 900px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .large {
      grid-column: span 2;
    }
  }

  /* Stack for mobile */
  @media (max-width: 600px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }
    .large, .medium, .small {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>

---
import toolkit from '../data/toolkit.json';
---

<section class="toolkit" id="toolkit" aria-labelledby="toolkit-heading">
  <h2 id="toolkit-heading">Toolkit</h2>
  <div class="bento-grid">
    {toolkit.map(group => (
      <div class="bento-item glass" data-size={group.size}>
        <div class="bento-inner">
          <h3>{group.category}</h3>
          <ul class="skill-list" role="list">
            {group.items.map(item => (
              <li class="skill-tag">{item}</li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .toolkit {
    margin: 4rem 0;
    container-type: inline-size;
    container-name: toolkit;
    content-visibility: auto;
    contain-intrinsic-size: auto 240px;
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: var(--accent);
    font-family: var(--font-serif);
  }

  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .bento-item {
    container-type: inline-size;
    container-name: bento-card;
    padding: clamp(1.25rem, 3cqi, 2rem);
  }

  .bento-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    height: 100%;
  }

  .bento-inner h3 {
    font-size: 0.9rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-tag {
    font-size: 0.85rem;
    color: var(--text);
    padding: 0.4rem 0.8rem;
    background: var(--tag-bg);
    border: 1px solid var(--tag-border);
    border-radius: 6px;
  }

  @container toolkit (min-width: 42em) {
    .bento-grid {
      grid-template-columns: repeat(6, 1fr);
    }

    .bento-item[data-size="large"] {
      grid-column: span 6;
    }

    .bento-item[data-size="medium"],
    .bento-item[data-size="small"] {
      grid-column: span 3;
    }
  }

  @container bento-card (min-width: 38em) {
    .bento-inner {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 2rem;
    }

    .bento-inner h3 {
      flex-shrink: 0;
      min-inline-size: 10rem;
    }

    .bento-inner .skill-list {
      flex: 1;
    }
  }
</style>

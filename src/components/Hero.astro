---

<header class="hero">
  <div class="intro">
    <h1>Saul Herman</h1>
    <p class="subtitle">Senior Client Platform Engineer & Founder</p>
    <p class="description">
      Specializing in large-scale macOS/Windows fleet management and high-quality product engineering. 
      Ex-Atlassian with a passion for building tools that bridge hardware and software.
    </p>
  </div>

  <div class="hero-links">
    <a href="/saul_herman_resume.pdf" class="btn secondary" download>Resume PDF</a>
    <a href="mailto:saulmherman@icloud.com" class="btn primary">Get in touch</a>
    <div class="social-links">
      <a href="https://github.com/thewaulicus" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://linkedin.com/in/bettercallsaui" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </div>
</header>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding: 6rem 0 4rem;
  }

  .intro h1 {
    font-size: var(--title-size);
    line-height: 1.1;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--accent);
    font-family: var(--font-sans);
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .description {
    max-width: 600px;
    font-size: 1.1rem;
    color: var(--sub);
    line-height: 1.6;
  }

  .hero-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .btn {
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
    letter-spacing: 0.02em;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn.primary {
    color: var(--accent);
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--accent);
    border-radius: 6px;
    background: transparent;
  }

  .btn.primary:hover {
    background: rgba(232, 213, 163, 0.05);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(232, 213, 163, 0.1);
  }

  .btn.secondary {
    color: var(--sub);
    border-bottom: 1px solid transparent;
  }

  .btn.secondary:hover {
    color: var(--text);
    border-bottom-color: var(--accent);
  }

  .social-links {
    display: flex;
    gap: 1.5rem;
    padding-left: 1rem;
    border-left: 1px solid var(--glass-border);
  }

  .social-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.2s ease;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .social-links a:hover {
    color: var(--text);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 4rem 0 2rem;
    }
    .hero-links {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
    .social-links {
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--glass-border);
      padding-top: 1rem;
      width: 100%;
    }
  }
</style>

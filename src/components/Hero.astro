---
import FeatureCard from './FeatureCard.astro';
import { getEntry } from 'astro:content';

const extractionLab = await getEntry('projects', 'extraction-lab');
---

<header class="hero">
  <div class="intro">
    <h1>Saul Herman</h1>
    <p class="subtitle">Senior Client Platform Engineer & Founder</p>
    <p class="description">
      Specializing in large-scale macOS/Windows fleet management and high-quality product engineering. 
      Ex-Atlassian with a passion for building tools that bridge hardware and software.
    </p>
  </div>

  <div class="featured-grid">
    <FeatureCard
      title={extractionLab?.data.title || "Extraction Lab"}
      description={extractionLab?.data.description || "Professional coffee intelligence platform."}
      tags={extractionLab?.data.tags || ["AI", "SwiftUI", "Apple Ecosystem"]}
      type="product"
      href={extractionLab?.data.url || "https://extractionlab.app"}
    />
    <FeatureCard
      title="Fleet Engineering"
      description="Managing 32,000+ endpoints with 75%+ CIS L2 compliance across the globe."
      tags={["Jamf Pro", "Python", "Security", "Scale"]}
      type="scale"
      href="#experience"
    />
  </div>
</header>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding: 4rem 0;
  }

  .intro h1 {
    font-size: var(--title-size);
    line-height: 1.1;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--accent);
    font-family: var(--font-sans);
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .description {
    max-width: 600px;
    font-size: 1.1rem;
    color: var(--sub);
    line-height: 1.6;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }
    
    .hero {
      padding: 2rem 0;
    }
  }
</style>

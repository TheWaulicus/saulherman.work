<header class="hero">
  <div class="intro">
    <h1>Saul Herman</h1>
    <p class="subtitle">Senior Client Platform Engineer & Founder</p>
    <p class="description">
      Specializing in large-scale macOS/Windows fleet management and high-quality product engineering. 
      Ex-Atlassian with a passion for building tools that bridge hardware and software.
    </p>
  </div>

  <div class="hero-links">
    <a href="/saul_herman_resume.pdf" class="btn secondary" download>Resume PDF</a>
    <a href="mailto:saulmherman@icloud.com" class="btn primary">Get in touch</a>
    <div class="social-links">
      <a href="https://github.com/thewaulicus" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://linkedin.com/in/bettercallsaui" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </div>
</header>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding: 6rem 0 4rem;
  }

  .intro h1 {
    font-size: var(--title-size);
    line-height: 1.1;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--accent);
    font-family: var(--font-sans);
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .description {
    max-width: 600px;
    font-size: 1.1rem;
    color: var(--sub);
    line-height: 1.6;
  }

  .hero-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .primary {
    background: var(--accent);
    color: var(--bg);
  }

  .primary:hover {
    background: #f0e0b0;
    transform: translateY(-2px);
  }

  .secondary {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--glass-border);
  }

  .secondary:hover {
    background: var(--glass);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .social-links {
    display: flex;
    gap: 1.25rem;
    margin-left: 0.5rem;
  }

  .social-links a {
    color: var(--sub);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .social-links a:hover {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 4rem 0 2rem;
    }
    .hero-links {
      gap: 1rem;
    }
  }
</style>

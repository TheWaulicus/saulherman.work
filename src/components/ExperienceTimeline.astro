---
import { getCollection, render } from 'astro:content';
import { formatMonthYear, toYearMonthString } from '../utils/dates';

const experienceEntries = await getCollection('experience');
experienceEntries.sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

const experience = await Promise.all(experienceEntries.map(async (entry) => {
  const { Content } = await render(entry);
  return { entry, Content };
}));
---

<section class="experience" id="experience" aria-labelledby="experience-heading">
  <h2 id="experience-heading">Experience</h2>
  <ol class="timeline" role="list">
    {experience.map(({ entry, Content }, index) => (
      <li class="timeline-item">
        <div class="timeline-marker" aria-hidden="true"></div>
        <div class="timeline-content">
          <div class="meta">
            <span class="period">
              <time datetime={toYearMonthString(entry.data.startDate)}>{formatMonthYear(entry.data.startDate)}</time>
              {' – '}
              {entry.data.endDate ? (
                <time datetime={toYearMonthString(entry.data.endDate)}>{formatMonthYear(entry.data.endDate)}</time>
              ) : (
                'Present'
              )}
            </span>
            <span class="location">{entry.data.location}</span>
          </div>
          <div class="card glass">
            <div class="header">
              <h3>{entry.data.role}</h3>
              <p class="company">{entry.data.company}</p>
            </div>
            {index < 2 ? (
              <div class="mdx-content">
                <Content />
              </div>
            ) : (
              <details class="role-details">
                <summary>
                  Highlights &amp; responsibilities
                  <span class="visually-hidden">: {entry.data.role}, {entry.data.company}</span>
                </summary>
                <div class="mdx-content">
                  <Content />
                </div>
              </details>
            )}
            {entry.data.tags && (
              <ul class="tags" role="list">
                {entry.data.tags.map(tag => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .experience {
    margin: 1rem 0 4rem;
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: var(--accent);
  }

  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--glass-border);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
  }

  /*
   * Below-the-fold roles skip rendering until they near the viewport.
   * content-visibility applies paint containment, so it goes on the content
   * wrapper: on the <li> it would clip the marker, which sits outside the box.
   */
  .timeline-item:nth-child(n+3) > .timeline-content {
    content-visibility: auto;
    contain-intrinsic-size: auto 260px;
  }

  .timeline-marker {
    position: absolute;
    left: -2rem;
    top: 0.5rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateX(-50%);
    box-shadow: 0 0 10px var(--accent);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--sub);
    margin-bottom: 0.5rem;
    font-family: var(--font-sans);
  }

  .card {
    padding: 1.5rem;
  }

  .header h3 {
    font-size: 1.25rem;
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .company {
    font-size: 1rem;
    color: var(--accent);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .mdx-content {
    font-size: 0.95rem;
    color: color-mix(in oklab, var(--text) 92%, var(--bg));
  }

  .mdx-content :global(ul) {
    padding-left: 1.25rem;
    margin: 1rem 0;
  }

  .mdx-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .role-details summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    min-block-size: 1.5rem;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--sub);
    border-radius: 4px;
    transition: color 0.2s ease;
  }

  .role-details summary::-webkit-details-marker {
    display: none;
  }

  .role-details summary::before {
    content: "";
    inline-size: 0.75em;
    block-size: 0.75em;
    flex-shrink: 0;
    background-color: currentColor;
    clip-path: polygon(10% 25%, 90% 25%, 50% 80%);
    rotate: -90deg;
  }

  .role-details summary:dir(rtl)::before {
    rotate: 90deg;
  }

  .role-details[open] > summary::before {
    rotate: 0deg;
  }

  .role-details summary:hover,
  .role-details[open] > summary {
    color: var(--text);
  }

  .role-details summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .role-details::details-content {
    interpolate-size: allow-keywords;
    overflow: clip;
    contain: layout;
  }

  .role-details:not([open])::details-content {
    block-size: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .role-details summary::before {
      transition: rotate 0.2s ease;
    }

    .role-details::details-content {
      transition: block-size, content-visibility, display;
      transition-duration: 0.3s;
      transition-timing-function: ease-in-out;
      transition-behavior: allow-discrete;
    }
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    background: var(--tag-bg);
    border: 1px solid var(--tag-border);
    border-radius: 4px;
    color: var(--sub);
  }

  @media (pointer: coarse) {
    .role-details summary {
      min-block-size: 2.75rem;
    }
  }

  @media (forced-colors: active) {
    .role-details summary::before {
      forced-color-adjust: none;
      background-color: CanvasText;
    }
  }

  @media (max-width: 37.5em) {
    .meta {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>

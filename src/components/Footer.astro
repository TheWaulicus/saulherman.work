---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-content">
    <div class="copyright">
      &copy; {currentYear} Saul Herman
    </div>
    <nav class="footer-links">
      <a href="https://github.com/thewaulicus" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://linkedin.com/in/bettercallsaui" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    margin-top: 6rem;
    padding: 3rem 0;
    border-top: 1px solid var(--glass-border);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--muted);
    font-size: 0.85rem;
    font-family: var(--font-sans);
  }

  .footer-links {
    display: flex;
    gap: 2rem;
  }

  .footer-links a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .footer-content {
      flex-direction: column;
      gap: 1.5rem;
      text-align: center;
    }
  }
</style>
